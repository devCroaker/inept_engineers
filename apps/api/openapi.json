{
  "openapi": "3.1.0",
  "info": {
    "title": "Inept Engineers API",
    "version": "0.1.0",
    "description": "Backs ineptengineers.com. The OpenAPI document is generated from the same Zod schemas used for runtime validation, so the two cannot drift apart."
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "Session cookie issued by Better Auth after sign-in."
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          },
          "uptimeSeconds": {
            "type": "number"
          }
        },
        "required": [
          "status",
          "database",
          "uptimeSeconds"
        ]
      },
      "Viewer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "image": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "membershipLevel": {
            "$ref": "#/components/schemas/MembershipLevel"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            }
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "image",
          "membershipLevel",
          "roles",
          "profile"
        ]
      },
      "MembershipLevel": {
        "type": "string",
        "enum": [
          "foe",
          "member"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "sister",
          "officer",
          "captain",
          "triad",
          "medical",
          "money",
          "web",
          "kitchen"
        ]
      },
      "Profile": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "userId": {
            "type": "string"
          },
          "scaName": {
            "type": [
              "string",
              "null"
            ]
          },
          "pronouns": {
            "type": [
              "string",
              "null"
            ]
          },
          "city": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": [
              "string",
              "null"
            ]
          },
          "bio": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "userId",
          "scaName",
          "pronouns",
          "city",
          "state",
          "bio"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "unauthorized"
              },
              "message": {
                "type": "string",
                "example": "Sign in to continue."
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "EventList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          },
          "total": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ]
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "example": "autumn-war"
          },
          "title": {
            "type": "string",
            "example": "Autumn War"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "$ref": "#/components/schemas/EventKind"
          },
          "status": {
            "$ref": "#/components/schemas/EventStatus"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "externalRegistrationUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "capacity": {
            "type": [
              "integer",
              "null"
            ]
          },
          "attendance": {
            "$ref": "#/components/schemas/AttendanceSummary"
          },
          "viewerRsvp": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "status": {
                "$ref": "#/components/schemas/RsvpStatus"
              },
              "arrivalDate": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "departureDate": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "guestCount": {
                "type": "integer"
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "status",
              "arrivalDate",
              "departureDate",
              "guestCount",
              "notes"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "description",
          "kind",
          "status",
          "startsAt",
          "endsAt",
          "location",
          "address",
          "externalRegistrationUrl",
          "capacity",
          "attendance",
          "viewerRsvp",
          "createdAt",
          "updatedAt"
        ]
      },
      "EventKind": {
        "type": "string",
        "enum": [
          "camping",
          "party",
          "day_event",
          "practice",
          "meeting",
          "other"
        ]
      },
      "EventStatus": {
        "type": "string",
        "enum": [
          "draft",
          "published",
          "cancelled"
        ]
      },
      "AttendanceSummary": {
        "type": "object",
        "properties": {
          "yes": {
            "type": "integer"
          },
          "maybe": {
            "type": "integer"
          },
          "no": {
            "type": "integer"
          },
          "expectedHeadcount": {
            "type": "integer"
          }
        },
        "required": [
          "yes",
          "maybe",
          "no",
          "expectedHeadcount"
        ]
      },
      "RsvpStatus": {
        "type": "string",
        "enum": [
          "yes",
          "no",
          "maybe"
        ]
      },
      "CreateEvent": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "$ref": "#/components/schemas/EventKind"
          },
          "status": {
            "$ref": "#/components/schemas/EventStatus"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "externalRegistrationUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "capacity": {
            "type": [
              "integer",
              "null"
            ],
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "slug",
          "title",
          "startsAt"
        ]
      },
      "UpdateEvent": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "$ref": "#/components/schemas/EventKind"
          },
          "status": {
            "$ref": "#/components/schemas/EventStatus"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "externalRegistrationUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "capacity": {
            "type": [
              "integer",
              "null"
            ],
            "exclusiveMinimum": 0
          }
        }
      },
      "UpsertRsvp": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/RsvpStatus"
          },
          "arrivalDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "departureDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "guestCount": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "AttendeeList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attendee"
            }
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ]
      },
      "Attendee": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "scaName": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/RsvpStatus"
          },
          "arrivalDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "departureDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "guestCount": {
            "type": "integer"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "userId",
          "name",
          "scaName",
          "status",
          "arrivalDate",
          "departureDate",
          "guestCount",
          "notes"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Liveness and database connectivity check",
        "responses": {
          "200": {
            "description": "Service is reachable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "Members"
        ],
        "summary": "The signed-in member",
        "description": "Returns identity, membership level, roles, and public profile. Sensitive stores (contact details, emergency contacts, dietary, medical) are deliberately not included here; each is served by its own endpoint so their narrower audiences stay enforced.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "The signed-in member.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Viewer"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/events": {
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "List events",
        "description": "Upcoming published events by default. Drafts and cancelled events are only visible to members who can manage events.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "default": 0
            },
            "required": false,
            "name": "offset",
            "in": "query"
          },
          {
            "schema": {
              "$ref": "#/components/schemas/EventStatus"
            },
            "required": false,
            "name": "status",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "upcoming",
                "past",
                "all"
              ],
              "default": "upcoming"
            },
            "required": false,
            "name": "when",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of events.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventList"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Events"
        ],
        "summary": "Create an event",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEvent"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created event.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "You do not hold a role that can manage events.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "An event already uses that slug.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/{slug}": {
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "Fetch one event",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "autumn-war"
            },
            "required": true,
            "name": "slug",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The event.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such event, or it is not published and you cannot see drafts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Events"
        ],
        "summary": "Update an event",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "autumn-war"
            },
            "required": true,
            "name": "slug",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated event.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "You do not hold a role that can manage events.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such event.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/{slug}/rsvp": {
      "put": {
        "tags": [
          "Events"
        ],
        "summary": "Create or change your own RSVP",
        "description": "Idempotent: one RSVP exists per member per event, so changing your mind updates it rather than adding another. Any signed-in member may RSVP, including a Friend of Engineers.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "autumn-war"
            },
            "required": true,
            "name": "slug",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertRsvp"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The event, including your updated RSVP.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such event.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The event is cancelled, or it has already finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/{slug}/rsvps": {
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "Who is coming",
        "description": "Visible to any signed-in member, since knowing who is attending is the point. Contains no contact, dietary, or medical information; those have narrower audiences and their own endpoints.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "autumn-war"
            },
            "required": true,
            "name": "slug",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Everyone who has responded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttendeeList"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such event.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
