# Local development only. Deployed environments use RDS IAM auth, so no password.
DATABASE_URL=postgresql://inept:localdev@localhost:5433/inept

# API
API_PORT=8787

# Web to API base URL. In AWS this is same-origin /api via CloudFront.
NEXT_PUBLIC_API_URL=http://localhost:8787

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OAuth providers (create apps at console.cloud.google.com and discord.com/developers)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
